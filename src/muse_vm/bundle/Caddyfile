# Public HTTPS for the adapter. Certificates are obtained and renewed automatically.
# No access log is configured, so connector addresses are never written to disk here.
{
	admin off
}

{$MMA_HOSTNAME} {
	encode zstd gzip

	# The adapter refuses bodies over 1 MiB; refuse them here first.
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cache-Control "no-store"
		-Server
	}

	reverse_proxy adapter:8080 {
		transport http {
			response_header_timeout 150s
		}
	}
}
